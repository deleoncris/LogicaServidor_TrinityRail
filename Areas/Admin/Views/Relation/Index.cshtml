@model LogicaServidor.Areas.Admin.Models.IndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Relaciones PLC ↔ Sensor</title>
  <link rel="stylesheet" href="~/css/styles_index.css" />
</head>
<body>

  <canvas class="bg-canvas" id="bgCanvas" aria-hidden="true"></canvas>

  <div class="page-content">

    <!-- Header -->
    <div class="page-header">
      <div class="page-header__left">
        <span class="page-label">PANEL DE ADMINISTRACIÓN · RED</span>
        <h1 class="page-title">Relaciones PLC ↔ Sensor</h1>
      </div>
      <div class="autosave" id="autosave">
        <span class="autosave__dot"></span>
        <span class="autosave__text" id="autosaveText">Guardado automático cada 10 s</span>
      </div>
    </div>

    <!-- Layout principal -->
    <div class="layout">

      <!-- Lista PLCs -->
      <div class="panel">
        <div class="panel__header">
          <span class="panel__label">PLCs</span>
          <span class="panel__count" id="countPlc">0</span>
        </div>
        <div class="panel__list" id="listaPlc"></div>
      </div>

      <!-- Lista Sensores -->
      <div class="panel">
        <div class="panel__header">
          <span class="panel__label">Sensores</span>
          <span class="panel__count" id="countSensor">0</span>
        </div>
        <div class="panel__list" id="listaSensor"></div>
      </div>

      <!-- Tabla de relaciones -->
      <div class="table-panel">
        <div class="table-panel__header">
          <span class="table-panel__label">RELACIONES ACTIVAS</span>
          <span class="rel-count" id="relCount">0 relaciones</span>
        </div>
        <table>
          <thead>
            <tr>
              <th>PLC</th>
              <th>SENSOR / DISPOSITIVO</th>
              <th style="width:50px;text-align:center">—</th>
            </tr>
          </thead>
          <tbody id="tabla"></tbody>
        </table>
      </div>

    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast">
    <span class="toast__dot"></span>
    <span id="toastMsg"></span>
  </div>

  <script>
    // ── Datos del servidor (Razor) ──────────────────
    const initialPlcs = @Html.Raw(
      System.Text.Json.JsonSerializer.Serialize(
        Model.Plcs.Select(p => new { ip = p.Ip, hostname = p.Hostname })
      )
    );
    const initialSensores = @Html.Raw(
      System.Text.Json.JsonSerializer.Serialize(
        Model.Dispositivos.Select(d => new { numeroSerie = d.NumeroSerie, token = d.Token })
      )
    );
    const initialRelaciones = @Html.Raw(
      System.Text.Json.JsonSerializer.Serialize(
        Model.Relaciones.Select(r => new {
          plc = new { ip = r.Item1.Ip, hostname = r.Item1.Hostname },
          sensor = new { numeroSerie = r.Item2.NumeroSerie, token = r.Item2.Token }
        })
      )
    );

    // ── Estado ─────────────────────────────────────
    let elementoArrastrado = null;
    const tabla = document.getElementById("tabla");

    // ── Canvas partículas ───────────────────────────
    (function () {
      const canvas = document.getElementById("bgCanvas");
      const ctx = canvas.getContext("2d");
      let W, H, particles = [];
      function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
      function mk() { return { x: Math.random()*W, y: Math.random()*H, r: Math.random()*1.2+0.3, vx: (Math.random()-.5)*.25, vy: (Math.random()-.5)*.25, a: Math.random()*.5+.1 }; }
      function init() { particles = Array.from({length:60}, mk); }
      function draw() {
        ctx.clearRect(0,0,W,H);
        particles.forEach(p => {
          p.x+=p.vx; p.y+=p.vy;
          if(p.x<0)p.x=W; if(p.x>W)p.x=0; if(p.y<0)p.y=H; if(p.y>H)p.y=0;
          ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
          ctx.fillStyle=`rgba(184,255,60,${p.a})`; ctx.fill();
        });
        requestAnimationFrame(draw);
      }
      resize(); init(); draw();
      window.addEventListener("resize", ()=>{ resize(); init(); });
    })();

    // ── Helpers ─────────────────────────────────────
    function plcLabel(plc) {
      return plc.hostname || plc.ip;
    }
    function sensorLabel(s) {
      return s.numeroSerie;
    }

    function actualizarContadores() {
      document.getElementById("countPlc").textContent =
        document.getElementById("listaPlc").querySelectorAll(".chip").length;
      document.getElementById("countSensor").textContent =
        document.getElementById("listaSensor").querySelectorAll(".chip").length;

      const filas = [...tabla.querySelectorAll("tr:not(.row-empty)")];
      const completas = filas.filter(f =>
        f.querySelector('[data-tipo="plc"]').dataset.valor &&
        f.querySelector('[data-tipo="sensor"]').dataset.valor
      ).length;
      document.getElementById("relCount").textContent =
        completas + (completas === 1 ? " relación" : " relaciones");
    }

    // ── Crear chip ──────────────────────────────────
    function crearChip(data, tipo) {
      const div = document.createElement("div");
      div.className = `chip chip--${tipo}`;
      div.draggable = true;
      div.dataset.tipo = tipo;
      div.dataset.json = JSON.stringify(data);
      div.textContent = tipo === "plc" ? plcLabel(data) : sensorLabel(data);
      div.addEventListener("dragstart", () => {
        elementoArrastrado = div;
        setTimeout(() => div.classList.add("dragging"), 0);
      });
      div.addEventListener("dragend", () => div.classList.remove("dragging"));
      return div;
    }

    // ── Render dropzone vacía ───────────────────────
    function renderDropzoneVacia(zona) {
      const tipo = zona.dataset.tipo;
      zona.dataset.valor = "";
      zona.innerHTML = `<span class="dropzone__placeholder">Arrastra ${tipo === "plc" ? "PLC" : "Sensor"}</span>`;
    }

    // ── Render dropzone llena ───────────────────────
    function renderDropzoneLlena(zona, label, jsonData) {
      zona.dataset.valor = jsonData;
      zona.innerHTML = `
        <div class="dropzone__filled">
          <span class="dropzone__val">${label}</span>
          <button class="btn-clear" title="Quitar">✕</button>
        </div>`;
      zona.querySelector(".btn-clear").onclick = ev => {
        ev.stopPropagation();
        devolverElemento(zona);
        asegurarUnaSolaFilaVacia();
        actualizarContadores();
      };
    }

    // ── Devolver elemento a su lista ────────────────
    function devolverElemento(zona) {
      const raw = zona.dataset.valor;
      if (!raw) return;
      const tipo = zona.dataset.tipo;
      const data = JSON.parse(raw);
      const lista = tipo === "plc"
        ? document.getElementById("listaPlc")
        : document.getElementById("listaSensor");
      lista.appendChild(crearChip(data, tipo));
      renderDropzoneVacia(zona);
    }

    // ── Activar dropzones de una fila ───────────────
    function activarDropzones(fila) {
      fila.querySelectorAll(".dropzone").forEach(zona => {
        zona.addEventListener("dragover", e => {
          e.preventDefault();
          zona.classList.add("over");
        });
        zona.addEventListener("dragleave", () => zona.classList.remove("over"));
        zona.addEventListener("drop", e => {
          e.preventDefault();
          zona.classList.remove("over");
          if (!elementoArrastrado) return;
          if (elementoArrastrado.dataset.tipo !== zona.dataset.tipo) return;

          devolverElemento(zona);

          const data = JSON.parse(elementoArrastrado.dataset.json);
          const label = tipo => tipo === "plc" ? plcLabel(data) : sensorLabel(data);
          renderDropzoneLlena(zona, label(zona.dataset.tipo), JSON.stringify(data));

          elementoArrastrado.remove();
          elementoArrastrado = null;

          fila.classList.remove("row-empty");
          asegurarUnaSolaFilaVacia();
          actualizarContadores();
        });
      });
    }

    // ── Crear fila ──────────────────────────────────
    function crearFila(plcData, sensorData) {
      const fila = document.createElement("tr");
      if (!plcData && !sensorData) fila.classList.add("row-empty");

      fila.innerHTML = `
        <td data-tipo="plc"><div class="dropzone" data-tipo="plc"></div></td>
        <td data-tipo="sensor"><div class="dropzone" data-tipo="sensor"></div></td>
        <td><button class="btn-del" title="Eliminar fila">✕</button></td>
      `;

      const zdPlc    = fila.querySelector('[data-tipo="plc"] .dropzone');
      const zdSensor = fila.querySelector('[data-tipo="sensor"] .dropzone');

      if (plcData)    renderDropzoneLlena(zdPlc,    plcLabel(plcData),    JSON.stringify(plcData));
      else            renderDropzoneVacia(zdPlc);
      if (sensorData) renderDropzoneLlena(zdSensor, sensorLabel(sensorData), JSON.stringify(sensorData));
      else            renderDropzoneVacia(zdSensor);

      fila.querySelector(".btn-del").onclick = () => {
        devolverElemento(zdPlc);
        devolverElemento(zdSensor);
        fila.remove();
        asegurarUnaSolaFilaVacia();
        actualizarContadores();
      };

      activarDropzones(fila);
      return fila;
    }

    // ── Garantizar exactamente una fila vacía al final ──
    function asegurarUnaSolaFilaVacia() {
      const filas = [...tabla.querySelectorAll("tr")];
      let vacias = filas.filter(f => {
        const pv = f.querySelector('[data-tipo="plc"] .dropzone')?.dataset.valor || "";
        const sv = f.querySelector('[data-tipo="sensor"] .dropzone')?.dataset.valor || "";
        return !pv && !sv;
      });
      while (vacias.length > 1) { vacias.pop().remove(); }
      if (vacias.length === 0) tabla.appendChild(crearFila());
    }

    // ── Carga inicial ───────────────────────────────
    function cargarListas(plcs, sensores) {
      const listaPlc    = document.getElementById("listaPlc");
      const listaSensor = document.getElementById("listaSensor");
      listaPlc.innerHTML = "";
      listaSensor.innerHTML = "";
      plcs.forEach(p    => listaPlc.appendChild(crearChip(p, "plc")));
      sensores.forEach(s => listaSensor.appendChild(crearChip(s, "sensor")));
    }

    function cargarRelaciones(relaciones) {
      tabla.innerHTML = "";
      relaciones.forEach(r => tabla.appendChild(crearFila(r.plc, r.sensor)));
      tabla.appendChild(crearFila()); // fila vacía final
    }

    // ── Recargar datos desde el servidor ───────────
    async function actualizarDatos() {
      try {
        const response = await fetch('/Admin/Relation/ObtenerEstado');
        if (!response.ok) return;
        const data = await response.json();

        // Guardar qué PLCs y sensores ya están en la tabla
        const plcsEnUso    = new Set();
        const sensoresEnUso = new Set();
        [...tabla.querySelectorAll("tr")].forEach(f => {
          const pv = f.querySelector('[data-tipo="plc"] .dropzone')?.dataset.valor;
          const sv = f.querySelector('[data-tipo="sensor"] .dropzone')?.dataset.valor;
          if (pv) plcsEnUso.add(JSON.parse(pv).ip);
          if (sv) sensoresEnUso.add(JSON.parse(sv).numeroSerie);
        });

        // Actualizar solo listas (no tocar tabla con relaciones en curso)
        const listaPlc    = document.getElementById("listaPlc");
        const listaSensor = document.getElementById("listaSensor");

        const plcsLibres    = (data.plcs    || []).filter(p => !plcsEnUso.has(p.ip));
        const sensoresLibres = (data.dispositivos || []).filter(s => !sensoresEnUso.has(s.numeroSerie));

        listaPlc.innerHTML    = "";
        listaSensor.innerHTML = "";
        plcsLibres.forEach(p    => listaPlc.appendChild(crearChip(p, "plc")));
        sensoresLibres.forEach(s => listaSensor.appendChild(crearChip(s, "sensor")));

        actualizarContadores();
      } catch (_) {}
    }

    // ── Guardar relaciones ──────────────────────────
    let toastTimer = null;
    function mostrarToast(msg, esError = false) {
      const toast = document.getElementById("toast");
      document.getElementById("toastMsg").textContent = msg;
      toast.className = "toast" + (esError ? " toast--error" : "");
      void toast.offsetWidth;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 3000);
    }

    function setAutosave(estado, texto) {
      const el = document.getElementById("autosave");
      el.className = "autosave autosave--" + estado;
      document.getElementById("autosaveText").textContent = texto;
    }

    async function guardarRelaciones() {
      const relaciones = [];
      [...tabla.querySelectorAll("tr")].forEach(f => {
        const pdRaw = f.querySelector('[data-tipo="plc"] .dropzone')?.dataset.valor;
        const sdRaw = f.querySelector('[data-tipo="sensor"] .dropzone')?.dataset.valor;
        if (pdRaw && sdRaw) {
          relaciones.push({
            Item1: JSON.parse(pdRaw),
            Item2: JSON.parse(sdRaw)
          });
        }
      });

      if (relaciones.length === 0) return;

      setAutosave("saving", "Guardando…");
      try {
        const res = await fetch('/Admin/Relation/GuardarRelacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(relaciones)
        });
        if (res.ok) {
          setAutosave("ok", "Guardado · " + new Date().toLocaleTimeString());
          mostrarToast("Relaciones guardadas correctamente");
        } else {
          setAutosave("error", "Error al guardar");
          mostrarToast("Error al guardar relaciones", true);
        }
      } catch (e) {
        setAutosave("error", "Error de red");
        mostrarToast("Error de conexión", true);
      }
    }

    // ── Init ────────────────────────────────────────
    cargarListas(initialPlcs, initialSensores);
    cargarRelaciones(initialRelaciones);
    actualizarContadores();

    // Actualizar listas cada 10 s + guardar relaciones cada 10 s
    setInterval(() => {
      actualizarDatos();
      guardarRelaciones();
    }, 10000);
  </script>
</body>
</html>