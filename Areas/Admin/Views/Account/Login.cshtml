@model LogicaServidor.Areas.Admin.Models.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso al sistema</title>
  <link rel="stylesheet" href="~/css/styles_login.css" />
</head>
<body>

  <div class="page-wrapper">
    <canvas class="bg-canvas" id="bgCanvas" aria-hidden="true"></canvas>

    <main class="card">

      <!-- Header -->
      <div class="card__top">
        <div class="lock-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="12" cy="16" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="card__meta">
          <span class="card__label">PANEL DE CONTROL</span>
          <h1 class="card__title">Acceso al<br>sistema</h1>
        </div>
        <div class="card__status">
          <span class="status-dot"></span>
          <span class="status-text">En espera</span>
        </div>
      </div>

      <div class="divider"></div>

      <!-- Formulario -->
      <form class="config-form" asp-controller="Account" asp-action="Login" method="POST">

        <div class="fields-rail">
          <div class="rail-line" aria-hidden="true">
            <span class="rail-node rail-node--top"></span>
            <span class="rail-track"></span>
            <span class="rail-node rail-node--bottom"></span>
          </div>

          <div class="fields-stack">

            <!-- Usuario -->
            <div class="field">
              <label class="field__label" for="usuario">
                <span class="field__label-text">Usuario</span>
                <span class="field__tag">USER</span>
              </label>
              <div class="field__wrap">
                <input
                  asp-for="Usuario"
                  class="field__input"
                  id="usuario"
                  type="text"
                  name="usuario"
                  placeholder="nombre de usuario"
                  autocomplete="username"
                  spellcheck="false"
                />
              </div>
            </div>

            <!-- Contraseña -->
            <div class="field">
              <label class="field__label" for="password">
                <span class="field__label-text">Contraseña</span>
                <span class="field__tag">PASSWORD</span>
              </label>
              <div class="field__wrap">
                <input
                  asp-for="Contrasena"
                  class="field__input field__input--mono"
                  id="password"
                  type="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  spellcheck="false"
                />
                <button type="button" class="field__eye" id="togglePass" aria-label="Mostrar contraseña">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                  </svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" style="display:none">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" stroke="currentColor" stroke-width="1.8"/>
                    <line x1="1" y1="1" x2="23" y2="23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- Botón -->
        <button type="submit" class="btn-save" id="btnLogin">
          <span class="btn-save__inner">
            <svg class="btn-save__icon" viewBox="0 0 24 24" fill="none">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="10 17 15 12 10 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="15" y1="12" x2="3" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="btn-save__text">Ingresar</span>
          </span>
          <span class="btn-save__shine" aria-hidden="true"></span>
        </button>

      </form>

      <!-- Pie de tarjeta -->
      <p class="card__footer">Acceso restringido · Solo personal autorizado</p>

    </main>
  </div>

  <script src="~/js/app_login.js"></script>
</body>
</html>
